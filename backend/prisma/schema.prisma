generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model Member {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  lga       String
  ward      String?
  interests String[]
  message   String?
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lga])
  @@index([status])
  @@index([createdAt])
}

enum Status {
  PENDING
  VERIFIED
  REJECTED
}